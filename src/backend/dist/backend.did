type VaultSecretName = text;
type VaultError = 
 variant {
   AlreadyExists;
   InvalidName;
   NotAuthorized;
   NotFound;
 };
type VaultEntryView = 
 record {
   createdAt: int;
   maskedValue: text;
   name: VaultSecretName;
   provider: ProviderType;
   updatedAt: int;
 };
type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserAssignmentView = 
 record {
   "principal": text;
   providers: vec ProviderType;
 };
type TransformationOutput = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type TransformationInput = 
 record {
   context: blob;
   response: HttpRequestResult;
 };
type Timestamp = int;
type TimelineEvent = 
 record {
   customer: text;
   description: text;
   eventType: text;
   id: text;
   provider: opt ProviderType;
   severity: opt Severity;
   timestamp: int;
   title: text;
 };
type ThrottleEvent = 
 record {
   id: text;
   message: text;
   provider: ProviderType;
   retryAfterSec: opt nat;
   statusCode: opt nat;
   timestamp: Timestamp;
 };
type Severity = 
 variant {
   Critical;
   High;
   Low;
   Medium;
   Unknown;
 };
type SearchResult = 
 record {
   customer: text;
   description: text;
   id: text;
   provider: opt ProviderType;
   severity: opt Severity;
   sourceModule: text;
   timestamp: int;
   title: text;
 };
type RuleSeverityThreshold = 
 variant {
   All;
   AnyCritical;
   AnyHigh;
   AnyLow;
   AnyMedium;
   CriticalOrHigh;
 };
type Result__1 = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type Result_8 = 
 variant {
   err: text;
   ok: text;
 };
type Result_7 = 
 variant {
   err: text;
   ok: record {
         csvData: text;
         reportId: text;
       };
 };
type Result_6 = 
 variant {
   err: RateLimitError;
   ok;
 };
type Result_5 = 
 variant {
   err: VaultError;
   ok: text;
 };
type Result_4 = 
 variant {
   err: ReportingError;
   ok: ReportRun;
 };
type Result_3 = 
 variant {
   err: NotificationError;
   ok;
 };
type Result_2 = 
 variant {
   err: ReportingError;
   ok;
 };
type Result_1 = 
 variant {
   err: CredentialError;
   ok;
 };
type Result = 
 variant {
   err: VaultError;
   ok;
 };
type ReportingError = 
 variant {
   InvalidPeriod;
   InvalidRecipient: text;
   NotAuthorized;
   NotFound;
 };
type ReportType = 
 variant {
   ComplianceStatus;
   IncidentSummary;
   SecurityPosture;
   ThreatIntelSummary;
 };
type ReportTrigger = 
 variant {
   OnDemand;
   ScheduledMonthly;
   ScheduledWeekly;
 };
type ReportRunOutcome = 
 variant {
   Failed: text;
   Succeeded;
 };
type ReportRun = 
 record {
   customer: CustomerId;
   deliveries: vec ReportDeliveryOutcome;
   generatedAt: Timestamp;
   outcome: ReportRunOutcome;
   periodEnd: Timestamp;
   periodStart: Timestamp;
   providerScope: vec ProviderType;
   recipients: vec text;
   reportType: ReportType;
   runId: text;
   trigger: ReportTrigger;
 };
type ReportRecipientConfig = 
 record {
   customer: CustomerId;
   recipients: vec text;
   reportType: ReportType;
 };
type ReportDeliveryOutcome = 
 record {
   error: opt text;
   recipient: text;
   sentAt: opt Timestamp;
   success: bool;
 };
type RawFinding = 
 record {
   accountId: opt text;
   description: text;
   findingId: text;
   id: text;
   provider: ProviderType;
   rawMetadata: text;
   region: opt text;
   severity: Severity;
   timestamp: int;
   title: text;
 };
type RateLimitError = 
 variant {
   NotAuthorized;
   UnknownProvider;
 };
type RateLimitBackoffState = 
 record {
   backoffSeconds: nat;
   consecutiveThrottles: nat;
   lastResetAt: opt Timestamp;
   lastThrottledAt: opt Timestamp;
   nextAttemptAt: opt Timestamp;
   provider: ProviderType;
 };
type ProviderType = 
 variant {
   AWS;
   Azure;
   GCP;
 };
type ProviderPollingState = 
 record {
   consecutiveFailures: nat;
   findingsToday: nat;
   interval: PollingInterval;
   lastError: opt text;
   lastPollAttempt: opt int;
   lastSuccessfulPoll: opt int;
   provider: ProviderType;
   status: PollingStatus;
 };
type ProviderCredentialStatus = 
 record {
   configured: bool;
   fields: vec CredentialFieldView;
   provider: ProviderType;
   updatedAt: opt int;
 };
type ProviderCredentialInput = 
 variant {
   AWS: AwsCredentialInput;
   Azure: AzureCredentialInput;
   GCP: GcpCredentialInput;
 };
type PollingStatus = 
 variant {
   Active;
   AuthPaused;
   Error;
   Inactive;
 };
type PollingInterval = 
 variant {
   FifteenMin;
   FiveMin;
   OneHour;
   ThirtyMin;
 };
type PlaybookResult = 
 record {
   dryRunPreview: opt text;
   message: text;
   provider: opt ProviderType;
   rawApiError: opt text;
   success: bool;
 };
type Page = 
 record {
   items: vec NormalizedAlert;
   nextCursor: opt Cursor;
 };
type NotificationStatus = 
 variant {
   Acknowledged;
   Failed;
   Sent;
 };
type NotificationRouting = 
 record {
   cooldownMinutes: nat;
   customer: CustomerId;
   emailRecipients: vec text;
   escalationMinutes: opt nat;
   teamsWebhookUrl: opt text;
 };
type NotificationLog = 
 record {
   acknowledged: bool;
   acknowledgedAt: opt int;
   alertId: text;
   channel: NotificationChannel;
   customer: text;
   id: text;
   recipient: text;
   ruleId: text;
   status: NotificationStatus;
   timestamp: int;
 };
type NotificationError = 
 variant {
   InvalidRule: text;
   InvalidWebhookUrl: text;
   NotAuthorized;
   NotFound;
 };
type NotificationChannel = 
 variant {
   Email;
   InApp;
   TeamsWebhook;
 };
type NormalizedAlert = 
 record {
   accountId: opt text;
   assetId: opt text;
   assetType: opt text;
   customer: text;
   description: text;
   enrichment: opt AlertEnrichment;
   findingId: text;
   id: text;
   ingestionSource: opt variant {
                          Poll;
                          Webhook;
                        };
   mitre: opt MitreTag;
   originalSeverity: text;
   owner: opt text;
   provider: ProviderType;
   rawFindingId: text;
   recurrenceCount: nat;
   region: opt text;
   severity: Severity;
   status: AlertStatus;
   timestamp: int;
   title: text;
 };
type MitreTag = 
 record {
   tactic: text;
   technique: text;
   techniqueId: text;
 };
type MitreDetail = 
 record {
   description: text;
   mitigations: text;
   tacticName: text;
   techniqueName: text;
 };
type IpReputation = 
 record {
   abuseScore: nat;
   country: text;
   isp: text;
   lastReported: text;
   totalReports: nat;
 };
type IngestionStats = 
 record {
   activeProviders: nat;
   providerStates: vec ProviderPollingState;
   totalFindingsToday: nat;
 };
type IncidentStatus = 
 variant {
   Investigating;
   Open;
   Resolved;
 };
type HttpRequestResult = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type HttpHeader = 
 record {
   name: text;
   value: text;
 };
type GeneratedReport = 
 record {
   csvData: opt text;
   customer: text;
   dateRangeEnd: text;
   dateRangeStart: text;
   format: text;
   generatedAt: text;
   generatedBy: text;
   providerScope: vec text;
   reportId: text;
   reportType: text;
 };
type GcpCredentialInput = 
 record {
   projectIds: vec text;
   serviceAccountJson: text;
 };
type DomainRep = 
 record {
   cleanVotes: nat;
   lastAnalysisDate: text;
   maliciousVotes: nat;
   suspiciousVotes: nat;
 };
type CustomerId = text;
type Cursor = text;
type CredentialHealthStatus = 
 record {
   expiryNs: opt int;
   health: CredentialHealth;
   provider: text;
 };
type CredentialHealth = 
 variant {
   Authenticating;
   Error: text;
   Expired;
   ExpiringSoon: text;
   Valid;
 };
type CredentialFieldView = 
 record {
   isSet: bool;
   maskedValue: text;
   name: text;
 };
type CredentialError = 
 variant {
   InvalidCredential: text;
   NotAuthorized;
   NotFound;
   VaultError: text;
 };
type CorrelationStats = 
 record {
   byType: vec record {
                 text;
                 nat;
               };
   totalAllTime: nat;
   totalThisWeek: nat;
   totalToday: nat;
 };
type CorrelatedIncident = 
 record {
   affectedResources: vec text;
   assignedOwner: opt text;
   correlationWindowMinutes: nat;
   customer: text;
   detectedAt: int;
   incidentId: text;
   incidentType: text;
   notes: opt text;
   severity: Severity;
   sourceAlerts: vec text;
   sourceIp: opt text;
   sourceProviders: vec ProviderType;
   status: IncidentStatus;
   timeDeltaMinutes: float64;
 };
type ControlStatus = 
 variant {
   Failing;
   NoCoverage;
   Passing;
 };
type ConnectionTestResult = 
 variant {
   Failure: text;
   Success: text;
 };
type ComplianceTrendEntry = 
 record {
   framework: ComplianceFramework;
   passingControls: nat;
   score: nat;
   totalControls: nat;
   weekTimestamp: int;
 };
type ComplianceFramework = 
 variant {
   CISAws;
   CISAzure;
   CISGCP;
   ISO27001;
   NISTCSF;
   SOC2;
 };
type ComplianceControl = 
 record {
   controlId: text;
   description: text;
   failingFindings: nat;
   framework: ComplianceFramework;
   passingFindings: nat;
   provider: opt ProviderType;
   remediationGuidance: text;
   status: ControlStatus;
   title: text;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
type AzureCredentialInput = 
 record {
   clientId: text;
   clientSecret: text;
   subscriptionIds: vec text;
   tenantId: text;
 };
type AwsCredentialInput = 
 record {
   externalId: opt text;
   regions: vec text;
   roleArn: text;
 };
type AuditLogEntry = 
 record {
   action: text;
   actorId: text;
   customer: text;
   details: text;
   id: text;
   timestamp: int;
 };
type AssetType = 
 variant {
   AzureDatabase;
   AzureStorage;
   AzureVM;
   EC2;
   GCPCloudSQL;
   GCPCompute;
   GCPStorage;
   Lambda;
   Other;
   RDS;
   S3;
 };
type Asset = 
 record {
   accountId: text;
   assetType: AssetType;
   customer: text;
   id: text;
   lastSeen: int;
   name: text;
   openFindings: nat;
   provider: ProviderType;
   region: text;
   riskScore: nat;
   tags: vec record {
               text;
               text;
             };
 };
type AlertStatus = 
 variant {
   InProgress;
   Open;
   Resolved;
 };
type AlertRule = 
 record {
   assetId: opt text;
   channels: vec NotificationChannel;
   cooldownMinutes: nat;
   customer: text;
   enabled: bool;
   escalationMinutes: opt nat;
   escalationRecipient: opt text;
   findingType: opt text;
   id: text;
   name: text;
   provider: opt ProviderType;
   region: opt text;
   severityThreshold: opt RuleSeverityThreshold;
 };
type AlertEnrichment = 
 record {
   domainRep: opt DomainRep;
   enrichedAt: opt text;
   ipReputation: opt IpReputation;
   knownMaliciousIp: bool;
   mitreDetail: opt MitreDetail;
 };
service : {
  /// Acknowledge a notification log entry.
  acknowledgeNotification: (logId: text) -> (bool);
  /// Admin: assign (replace) the full set of providers a principal may access.
  /// Composes with the existing requireAuth guard (rejects anonymous callers).
  /// ProviderType is a closed variant, so every element is a known provider.
  assignProviderAccess: ("principal": principal, providers:
   vec ProviderType) -> ();
  /// Block an IP address across one or more cloud providers.
  /// dryRun=true returns a preview without making any API calls.
  blockIp: (req:
   record {
     customer: text;
     dryRun: bool;
     ip: text;
     providers: vec ProviderType;
   }) -> (PlaybookResult);
  /// Clear a provider's typed credential from its isolated vault secret.
  /// Returns `#NotFound` when no credential is stored.
  clearProviderCredential: (provider: ProviderType) -> (Result_1);
  /// Delete an alert rule by ID.
  deleteAlertRule: (id: text) -> (bool);
  /// Delete a generated report by ID.
  deleteReport: (reportId: text, customer: text) -> ();
  /// Delete a named secret for a provider. Composes requireAuth and
  /// writes an audit entry.
  deleteVaultSecret: (provider: ProviderType, name: VaultSecretName) ->
   (Result);
  /// Disable an Azure AD user account via Microsoft Graph API.
  disableAzureAdAccount: (req:
   record {
     customer: text;
     dryRun: bool;
     userPrincipalName: text;
   }) -> (PlaybookResult);
  /// Trigger enrichment for a specific alert on demand.
  enrichAlertPublic: (alertId: text, customer: text) -> (Result_8);
  /// Escalate an alert to a full correlated incident and create a Halo ticket.
  escalateToIncident: (req:
   record {
     alertId: text;
     assignedOwner: opt text;
     customer: text;
     dryRun: bool;
     notes: opt text;
     severity: text;
   }) -> (PlaybookResult);
  execute: (qJson: text) -> (Result__1) query;
  /// Export compliance report as CSV text.
  exportComplianceCsv: (framework: ComplianceFramework) -> (text) query;
  /// Export compliance report as PDF blob.
  exportCompliancePdf: (framework: ComplianceFramework) -> (blob) query;
  /// Export a generated report as branded PDF bytes. The caller supplies the
  /// report type, an explicit period, the customer and the provider scope; the
  /// endpoint renders the same executive summary used for email delivery plus
  /// a chart of the run's per-recipient delivery outcomes, and returns the
  /// PDF-1.4 bytes. This is a query so the frontend can download the document
  /// without a state change.
  exportReportPdf: (reportType: ReportType, periodStart: Timestamp,
   periodEnd: Timestamp, customer: CustomerId, providerScope:
   vec ProviderType) -> (blob) query;
  /// Force a GCP IAM review for a project, flagging over-privileged bindings.
  forceGcpIamReview: (req:
   record {
     customer: text;
     dryRun: bool;
     projectId: text;
   }) -> (PlaybookResult);
  /// Generate a report as CSV and store it.
  generateReport: (req:
   record {
     customer: text;
     dateRangeEnd: text;
     dateRangeStart: text;
     providerScope: vec text;
     reportType: text;
   }) -> (Result_7);
  /// Find a single alert by its ID.
  /// Requires the caller to be assigned to the alert's provider.
  getAlertById: (id: text) -> (opt NormalizedAlert) query;
  /// Return the caller's alert rules for a given customer, scoped to the
  /// providers the caller is assigned to. Requires a signed-in caller and a
  /// non-empty customer; an empty customer is never treated as match-all.
  getAlertRules: (customer: text) -> (vec AlertRule) query;
  /// Return normalized alerts whose id matches any entry in alertIds.
  /// Scoped to the providers the caller is assigned to.
  getAlertsForCorrelation: (alertIds: vec text) ->
   (vec NormalizedAlert) query;
  getApiDoc: () -> (text) query;
  /// Find a single asset by its ID.
  /// Requires the caller to be assigned to the asset's provider.
  getAssetById: (id: text) -> (opt Asset) query;
  /// Return all open/in-progress normalized alerts for a given asset.
  /// Scoped to the providers the caller is assigned to.
  getAssetFindings: (assetId: text) -> (vec NormalizedAlert) query;
  /// Return assets matching the provided filter criteria.
  /// Scoped to the providers the caller is assigned to.
  getAssets: (filter:
   record {
     assetType: opt AssetType;
     customer: text;
     limit: nat;
     minRiskScore: opt nat;
     provider: opt ProviderType;
     region: opt text;
   }) -> (vec Asset) query;
  /// Return audit log entries for a customer, sorted by timestamp descending.
  getAuditLog: (customer: text, limit: nat) -> (vec AuditLogEntry) query;
  /// Return controls that have status Failing or NoCoverage.
  getComplianceControlGaps: (framework: ComplianceFramework) ->
   (vec ComplianceControl) query;
  /// Return compliance status for a framework, counting passing/failing findings per control.
  /// Scoped to the providers the caller is assigned to.
  getComplianceStatus: (framework: ComplianceFramework, provider:
   opt ProviderType) ->
   (record {
      controls: vec ComplianceControl;
      failing: nat;
      passing: nat;
      score: nat;
      total: nat;
    }) query;
  /// Return compliance trend entries for a framework sorted by weekTimestamp ascending.
  getComplianceTrend: (framework: ComplianceFramework) ->
   (vec ComplianceTrendEntry) query;
  /// Return a correlated incident by its incidentId, or null if not found.
  /// Requires the caller to be assigned to one of the incident's source providers.
  getCorrelatedIncidentById: (id: text) -> (opt CorrelatedIncident) query;
  /// Return the most recent `limit` correlated incidents sorted by detectedAt descending.
  /// Scoped to incidents touching providers the caller is assigned to.
  getCorrelatedIncidents: (limit: nat) ->
   (vec record {
          text;
          CorrelatedIncident;
        }) query;
  /// Return aggregated correlation statistics for the dashboard panel.
  /// Scoped to incidents touching providers the caller is assigned to.
  getCorrelationStats: () -> (CorrelationStats) query;
  /// Return the health status of each provider's credentials.
  /// Checks in-memory token cache expiry; no network call.
  /// Scoped to the providers the caller is assigned to.
  getCredentialHealth: () -> (vec CredentialHealthStatus) query;
  /// Return which enrichment keys are configured (booleans only — never the key values).
  getEnrichmentKeys: () ->
   (record {
      abuseIpdbKeySet: bool;
      virusTotalKeySet: bool;
    });
  /// Return failed ingestion records, optionally filtered by provider.
  /// provider field is returned as Text to avoid Candid variant decoding issues on the frontend.
  /// Scoped to the providers the caller is assigned to.
  getFailedIngestions: (provider: opt ProviderType, limit: nat) ->
   (vec
     record {
       errorMessage: text;
       errorType: text;
       id: text;
       provider: text;
       rawPayload: text;
       status: text;
       timestamp: int;
     }) query;
  /// Return aggregated ingestion statistics for the dashboard.
  /// Scoped to the providers the caller is assigned to.
  getIngestionStats: () -> (IngestionStats) query;
  /// Frontend: read the current caller's assigned providers.
  getMyProviders: () -> (vec ProviderType) query;
  /// Return a cursor-paginated page of normalized alerts matching the provided
  /// filter criteria. Scoped to the providers the caller is assigned to.
  /// 
  /// `filter.cursor` is `null` for the first page; pass the returned
  /// `nextCursor` back verbatim to fetch the next page. `nextCursor` is `null`
  /// when the page is the last one. The cursor is keyed on the alert's
  /// (timestamp, id) sort key, so it stays stable across inserts.
  getNormalizedAlerts: (filter:
   record {
     cursor: opt Cursor;
     customer: text;
     limit: nat;
     provider: opt ProviderType;
     severity: opt Severity;
     status: opt AlertStatus;
   }) -> (Page) query;
  /// Return the caller's notification logs for a customer, sorted by timestamp
  /// descending. Requires a signed-in caller and a non-empty customer; an empty
  /// customer is never treated as match-all.
  getNotificationLogs: (filter: record {
                                  customer: text;
                                  limit: nat;
                                }) -> (vec NotificationLog) query;
  /// Return the notification routing for a customer, if configured.
  getNotificationRouting: (customer: CustomerId) ->
   (opt NotificationRouting) query;
  /// Return per-provider pipeline health stats for the dashboard.
  /// provider field is returned as Text to avoid Candid variant decoding issues on the frontend.
  /// Scoped to the providers the caller is assigned to.
  getPipelineHealth: () ->
   (vec
     record {
       avgLatencyMs: float64;
       failedIngestionCount: nat;
       normalizationSuccessRate: float64;
       pollEventsToday: nat;
       provider: text;
       webhookEventsToday: nat;
     }) query;
  /// Read a provider's typed credential status (configured/not configured and
  /// masked structured fields only). Never returns plaintext.
  getProviderCredentialStatus: (provider: ProviderType) ->
   (ProviderCredentialStatus) query;
  /// Return per-provider polling state (status, last poll time, error info).
  /// Scoped to the providers the caller is assigned to.
  getProviderStates: () -> (vec ProviderPollingState) query;
  /// Return the rate-limit backoff state for the providers the caller is
  /// assigned to. The canister controller (owner) sees every tracked provider.
  getRateLimitStates: () -> (vec RateLimitBackoffState) query;
  /// Return paginated raw findings for a given provider.
  /// limit: max items to return (default 100, max 500). offset: starting index.
  /// Requires the caller to be assigned to the requested provider.
  getRawFindings: (provider: ProviderType, limit: nat, offset: nat) ->
   (record {
      hasMore: bool;
      items: vec RawFinding;
      totalCount: nat;
    }) query;
  /// Return the CSV data for a specific report.
  getReportCsv: (reportId: text, customer: text) -> (opt text);
  /// Return email configs for a customer.
  getReportEmailConfig: (customer: text) ->
   (vec record {
          recipients: vec text;
          reportType: text;
        });
  /// Return the recipient configuration for a report type and customer.
  getReportRecipients: (reportType: ReportType, customer: CustomerId) ->
   (opt ReportRecipientConfig) query;
  /// Find a single report run by its ID, scoped to the caller's customer.
  getReportRun: (runId: text, customer: CustomerId) -> (opt ReportRun) query;
  /// Return report runs for a customer, newest first, capped at `limit`.
  getReportRuns: (customer: CustomerId, limit: nat) -> (vec ReportRun) query;
  /// Return the list of generated reports for a customer (without CSV data).
  getReports: (customer: text) -> (vec GeneratedReport);
  /// Return recent throttling events, optionally filtered to one provider,
  /// newest first, capped at `limit`. An explicit provider filter is
  /// access-checked against the caller's provider assignment. Without an
  /// explicit filter the result is scoped to the caller's assigned providers;
  /// the canister controller (owner) sees every provider.
  getThrottleEvents: (provider: opt ProviderType, limit: nat) ->
   (vec ThrottleEvent) query;
  /// Return recent timeline events for a customer, sorted by timestamp descending.
  /// Scoped to the providers the caller is assigned to.
  getTimeline: (customer: text, limit: nat) -> (vec TimelineEvent) query;
  /// Return which providers have a webhook secret configured (booleans only —
  /// never the secret values).
  getWebhookSecretStatus: () ->
   (record {
      awsSet: bool;
      azureSet: bool;
      gcpSet: bool;
    });
  /// Return aggregated webhook statistics for the dashboard.
  /// Scoped to the providers the caller is assigned to.
  getWebhookStats: () ->
   (record {
      webhookEventsToday: nat;
      webhookNormalizationRate: float64;
    }) query;
  /// Search across alerts, assets, and audit log.
  /// maxResults: cap total results (default 100, max 500). hasMore indicates truncation.
  /// Scoped to the providers the caller is assigned to.
  globalSearch: ("query": text, customer: text, maxResults: nat) ->
   (record {
      hasMore: bool;
      results: vec SearchResult;
    }) query;
  /// Returns true if a credential has been configured for at least one provider
  /// in the vault.
  hasAdminCredentials: () -> (bool) query;
  http_request: (request:
   record {
     body: blob;
     headers: vec record {
                    text;
                    text;
                  };
     method: text;
     url: text;
   }) ->
   (record {
      body: blob;
      headers: vec record {
                     text;
                     text;
                   };
      status_code: nat16;
      streaming_strategy: opt null;
      upgrade: opt bool;
    }) query;
  http_request_update: (request:
   record {
     body: blob;
     headers: vec record {
                    text;
                    text;
                  };
     method: text;
     url: text;
   }) ->
   (record {
      body: blob;
      headers: vec record {
                     text;
                     text;
                   };
      status_code: nat16;
      streaming_strategy: opt null;
      upgrade: opt bool;
    });
  /// Isolate a resource by modifying its network configuration.
  isolateResource: (req:
   record {
     customer: text;
     dryRun: bool;
     provider: ProviderType;
     resourceId: text;
   }) -> (PlaybookResult);
  /// Admin: list all users and their provider assignments.
  listUserAssignments: () -> (vec UserAssignmentView) query;
  /// List all vault entries for a provider as masked views (never plaintext).
  /// Composes requireAuth.
  listVaultSecrets: (provider: ProviderType) -> (vec VaultEntryView) query;
  /// Admin: remove a single provider from a principal's access.
  removeProviderAccess: ("principal": principal, provider: ProviderType) ->
   ();
  /// Clear a provider's backoff state after a successful poll.
  resetProviderBackoff: (provider: ProviderType) -> (Result_6);
  /// Reveal/decrypt a single secret value on demand. Composes
  /// requireAuth and writes an audit entry recording the reveal.
  revealVaultSecret: (provider: ProviderType, name: VaultSecretName) ->
   (Result_5);
  /// Revoke IAM credentials for a user/service account across providers.
  revokeIamCredentials: (req:
   record {
     accessKeyId: opt text;
     customer: text;
     dryRun: bool;
     provider: ProviderType;
     userId: text;
   }) -> (PlaybookResult);
  /// Run the unacknowledged-notification escalation check. For every
  /// notification whose rule defines an escalation window that has elapsed and
  /// that is still unacknowledged, deliver the escalation to the configured
  /// escalation recipient through the configured channel and record it in the
  /// notification log. Returns the number of escalations delivered.
  /// 
  /// This is the public entry point that drives `NotificationRouter.escalationsDue`;
  /// the same internal runner is also invoked from the system heartbeat so
  /// escalation runs without a manual call.
  runEscalationCheck: () -> (nat);
  /// Run a report on demand for an explicit date range, email it to the
  /// configured recipients, and record the run with its per-recipient
  /// delivery outcomes.
  runReportOnDemand: (reportType: ReportType, periodStart: Timestamp,
   periodEnd: Timestamp, customer: CustomerId, providerScope:
   vec ProviderType) -> (Result_4);
  /// Record a scheduled report run (weekly or monthly) for a customer,
  /// emailing the configured recipients and storing the delivery outcomes.
  runScheduledReport: (reportType: ReportType, trigger: ReportTrigger,
   customer: CustomerId, providerScope: vec ProviderType) -> (Result_4);
  /// Insert or update an alert rule.
  saveAlertRule: (rule: AlertRule) -> (bool);
  /// Save enrichment API keys (AbuseIPDB and VirusTotal).
  /// Key values are never returned to the frontend.
  saveEnrichmentKeys: (keys:
   record {
     abuseIpdbKey: opt text;
     virusTotalKey: opt text;
   }) -> ();
  /// Upsert the notification routing for a customer.
  saveNotificationRouting: (routing: NotificationRouting) -> (Result_3);
  /// Store a provider's typed credential as its isolated vault secret. Returns
  /// `#InvalidCredential` when a required field is missing, and
  /// `#VaultError("credential already exists")` when one is already stored.
  saveProviderCredential: (input: ProviderCredentialInput) -> (Result_1);
  /// Save (upsert) a report email configuration.
  saveReportEmailConfig: (config:
   record {
     customer: text;
     recipients: vec text;
     reportType: text;
   }) -> ();
  /// Upsert the recipient configuration for a report type and customer.
  /// Every recipient address is validated before saving; the first invalid
  /// address rejects the whole configuration.
  saveReportRecipients: (config: ReportRecipientConfig) -> (Result_2);
  /// Store a new named secret for a provider. Encrypted at rest; the value is
  /// never returned. Composes requireAuth and writes an audit entry.
  saveVaultSecret: (provider: ProviderType, name: VaultSecretName, value:
   text) -> (Result);
  /// Save the webhook signature secret for a provider.
  /// The secret value is stored write-only and is never returned to the frontend.
  saveWebhookSecret: (provider: ProviderType, secret: text) -> ();
  schema: () -> (text) query;
  /// Update the polling interval for a specific provider.
  setPollingInterval: (provider: ProviderType, interval: PollingInterval) ->
   ();
  /// Validate stored AWS credentials against the live API.
  /// Resolves the credential from the AWS vault entry; reports not configured
  /// when the vault has no AWS credential.
  testAwsConnection: () -> (ConnectionTestResult);
  /// Validate stored Azure credentials against the live API.
  /// Resolves the credential from the Azure vault entry; reports not configured
  /// when the vault has no Azure credential.
  testAzureConnection: () -> (ConnectionTestResult);
  /// Validate stored GCP credentials against the live API.
  /// Resolves the credential from the GCP vault entry; reports not configured
  /// when the vault has no GCP credential.
  testGcpConnection: () -> (ConnectionTestResult);
  /// Test a provider's stored credential against the live API. Resolves the
  /// credential from the provider's isolated vault entry; when the provider is
  /// unconfigured it returns a failure without attempting a connection.
  testProviderConnection: (provider: ProviderType) -> (ConnectionTestResult);
  transform: (input: TransformationInput) -> (TransformationOutput) query;
  /// Trigger an immediate poll for the specified provider.
  triggerPoll: (provider: ProviderType) -> ();
  /// Update the status and optional owner of an alert.
  updateAlertStatus: (id: text, newStatus: AlertStatus, owner: opt text) ->
   (bool);
  /// Update status, owner, and/or notes on a correlated incident. Returns true if found.
  updateCorrelatedIncidentStatus: (id: text, newStatus: IncidentStatus,
   owner: opt text, notes: opt text) -> (bool);
  /// Overwrite a provider's typed credential in its isolated vault secret.
  /// Returns `#NotFound` when no credential is stored yet.
  updateProviderCredential: (input: ProviderCredentialInput) -> (Result_1);
  /// Update an existing named secret for a provider. Composes
  /// requireAuth and writes an audit entry.
  updateVaultSecret: (provider: ProviderType, name: VaultSecretName, value:
   text) -> (Result);
}
