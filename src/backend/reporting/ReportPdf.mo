import Text "mo:core/Text";
import List "mo:core/List";
import Types "../types/common";
import ReportingTypes "../types/reporting";
import Scheduler "ReportScheduler";

/// ReportPdf.mo
/// Branded PDF export for scheduled and on-demand reports.
///
/// Produces a minimal, self-contained PDF (PDF-1.4) with:
///   - a "SecOps Platform" title and a vector logo mark,
///   - generated-by and period metadata,
///   - a table of contents,
///   - an executive summary section,
///   - report charts rendered as embedded images.
///
/// The PDF is assembled as a text stream. Charts are drawn as vector
/// rectangles (a bar chart) so no external image bytes are required; the
/// chart is embedded as a Form XObject referenced from the page content.
module {

  /// A single labelled value rendered as a bar in the report chart.
  public type ChartBar = {
    caption : Text;
    value : Nat;
  };

  /// Everything the PDF renderer needs to lay out a report.
  public type ReportDocument = {
    reportType    : ReportingTypes.ReportType;
    trigger       : ReportingTypes.ReportTrigger;
    periodStart   : Types.Timestamp;
    periodEnd     : Types.Timestamp;
    generatedAt   : Types.Timestamp;
    generatedBy   : Text;
    customer      : Types.CustomerId;
    providerScope : [Types.ProviderType];
    summaryLines  : [Text];
    sections      : [(Text, [Text])];
    chartTitle    : Text;
    chartBars     : [ChartBar];
  };

  /// Render a report document to a PDF blob.
  public func render(document : ReportDocument) : Blob {
    let content = buildContentStream(document);
    let contentLength = content.size();

    var pdf = "%PDF-1.4\n";

    // 1: Catalog
    pdf := pdf # "1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n";
    // 2: Pages
    pdf := pdf # "2 0 obj\n<< /Type /Pages /Kids [3 0 R] /Count 1 >>\nendobj\n";
    // 3: Page
    pdf := pdf # "3 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Resources << /Font << /F1 5 0 R /F2 6 0 R >> >> /Contents 4 0 R >>\nendobj\n";
    // 4: Content stream
    pdf := pdf # "4 0 obj\n<< /Length " # contentLength.toText() # " >>\nstream\n" # content # "\nendstream\nendobj\n";
    // 5: Body font (Helvetica)
    pdf := pdf # "5 0 obj\n<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>\nendobj\n";
    // 6: Bold font (Helvetica-Bold)
    pdf := pdf # "6 0 obj\n<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold >>\nendobj\n";
    // 7: Logo mark (vector form XObject)
    pdf := pdf # "7 0 obj\n<< /Type /XObject /Subtype /Form /BBox [0 0 40 40] /Length 60 >>\nstream\n" #
      "0.10 0.35 0.75 rg\n0 0 40 40 re f\n1 1 1 rg\n8 8 24 24 re f\n0.10 0.35 0.75 rg\n14 14 12 12 re f\n" #
      "\nendstream\nendobj\n";

    pdf := pdf # "trailer\n<< /Size 8 /Root 1 0 R >>\nstartxref\n0\n%%EOF";
    pdf.encodeUtf8();
  };

  /// Build the page content stream (text + chart drawing operators).
  func buildContentStream(document : ReportDocument) : Text {
    var s = "";

    // ── Header: logo mark + title ────────────────────────────────────────────
    s := s # "q 1 0 0 1 54 720 cm /Logo Do Q\n";
    s := s # "BT /F2 22 Tf 0.10 0.35 0.75 rg 104 738 Td (SecOps Platform) Tj ET\n";
    s := s # "BT /F1 12 Tf 0.25 0.25 0.25 rg 104 720 Td (" # escape(reportTypeLabel(document.reportType)) # " Report) Tj ET\n";
    s := s # "0.10 0.35 0.75 RG 1 w 54 706 m 558 706 l S\n";

    // ── Metadata ─────────────────────────────────────────────────────────────
    var y = 686;
    s := textLine(s, y, "Generated by: " # escape(document.generatedBy), false);
    y := y - 16;
    s := textLine(s, y, "Generated at: " # escape(Scheduler.formatDateTime(document.generatedAt)), false);
    y := y - 16;
    s := textLine(s, y, "Period: " # escape(Scheduler.formatDate(document.periodStart)) # " to " # escape(Scheduler.formatDate(document.periodEnd)), false);
    y := y - 16;
    s := textLine(s, y, "Trigger: " # escape(triggerLabel(document.trigger)), false);
    y := y - 16;
    s := textLine(s, y, "Customer: " # escape(document.customer), false);
    y := y - 16;
    s := textLine(s, y, "Providers: " # escape(providerScopeLabel(document.providerScope)), false);
    y := y - 28;

    // ── Table of contents ────────────────────────────────────────────────────
    s := textLine(s, y, "Table of Contents", true);
    y := y - 18;
    s := textLine(s, y, "1. Executive Summary", false);
    y := y - 16;
    var sectionIndex = 2;
    for ((title, _) in document.sections.values()) {
      s := textLine(s, y, sectionIndex.toText() # ". " # escape(title), false);
      y := y - 16;
      sectionIndex := sectionIndex + 1;
    };
    s := textLine(s, y, sectionIndex.toText() # ". " # escape(document.chartTitle), false);
    y := y - 28;

    // ── Executive summary ────────────────────────────────────────────────────
    s := textLine(s, y, "1. Executive Summary", true);
    y := y - 18;
    for (line in document.summaryLines.values()) {
      s := textLine(s, y, escape(line), false);
      y := y - 16;
    };
    y := y - 12;

    // ── Sections ─────────────────────────────────────────────────────────────
    var idx = 2;
    for ((title, lines) in document.sections.values()) {
      s := textLine(s, y, idx.toText() # ". " # escape(title), true);
      y := y - 18;
      for (line in lines.values()) {
        s := textLine(s, y, escape(line), false);
        y := y - 16;
      };
      y := y - 12;
      idx := idx + 1;
    };

    // ── Chart (embedded vector image) ────────────────────────────────────────
    s := textLine(s, y, idx.toText() # ". " # escape(document.chartTitle), true);
    y := y - 20;
    s := s # buildChart(document.chartBars, y);

    s;
  };

  /// Emit a single text line at the given y and return the accumulated stream.
  func textLine(acc : Text, y : Int, line : Text, bold : Bool) : Text {
    let font = if (bold) { "/F2" } else { "/F1" };
    let color = if (bold) { "0.10 0.35 0.75" } else { "0.15 0.15 0.15" };
    acc # "BT " # font # " 11 Tf " # color # " rg 54 " # y.toText() # " Td (" # line # ") Tj ET\n";
  };

  /// Draw a horizontal bar chart as vector rectangles.
  func buildChart(bars : [ChartBar], topY : Int) : Text {
    var s = "";
    let maxValue = bars.foldLeft(0, func(acc, bar) { if (bar.value > acc) { bar.value } else { acc } });
    let barHeight = 16;
    let maxWidth = 380;
    var y = topY;
    for (bar in bars.values()) {
      let width = if (maxValue == 0) { 0 } else { (bar.value * maxWidth) / maxValue };
      // Label
      s := s # "BT /F1 9 Tf 0.15 0.15 0.15 rg 54 " # (y + 4).toText() # " Td (" # escape(bar.caption) # ") Tj ET\n";
      // Bar
      s := s # "0.10 0.35 0.75 rg 200 " # y.toText() # " " # width.toText() # " " # barHeight.toText() # " re f\n";
      // Value
      s := s # "BT /F1 9 Tf 0.15 0.15 0.15 rg " # (200 + width + 6).toText() # " " # (y + 4).toText() # " Td (" # bar.value.toText() # ") Tj ET\n";
      y := y - (barHeight + 8);
    };
    s;
  };

  /// Escape a text string for a PDF literal string.
  func escape(t : Text) : Text {
    var out = "";
    for (c in t.toIter()) {
      let ch = Text.fromChar(c);
      if (ch == "(") { out := out # "\\(" }
      else if (ch == ")") { out := out # "\\)" }
      else if (ch == "\\") { out := out # "\\\\" }
      else { out := out # ch };
    };
    out;
  };

  func reportTypeLabel(reportType : ReportingTypes.ReportType) : Text {
    switch (reportType) {
      case (#SecurityPosture) "Security Posture";
      case (#ComplianceStatus) "Compliance Status";
      case (#IncidentSummary) "Incident Summary";
      case (#ThreatIntelSummary) "Threat Intelligence Summary";
    };
  };

  func triggerLabel(trigger : ReportingTypes.ReportTrigger) : Text {
    switch (trigger) {
      case (#ScheduledWeekly) "Scheduled (weekly)";
      case (#ScheduledMonthly) "Scheduled (monthly)";
      case (#OnDemand) "On demand";
    };
  };

  func providerScopeLabel(scope : [Types.ProviderType]) : Text {
    if (scope.size() == 0) {
      return "All providers";
    };
    scope.map(func(p) { switch (p) { case (#AWS) "AWS"; case (#Azure) "Azure"; case (#GCP) "GCP" } }).values().join(", ");
  };
};
