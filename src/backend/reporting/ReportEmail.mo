import List "mo:core/List";
import Time "mo:core/Time";
import EmailClient "mo:caffeineai-email/emailClient";
import Types "../types/common";
import ReportingTypes "../types/reporting";
import Scheduler "ReportScheduler";

/// ReportEmail.mo
/// Email delivery for scheduled and on-demand reports.
///
/// Sends one email per recipient through the email extension and records the
/// per-recipient delivery outcome (sent or failed) on the report run.
module {

  /// The subject line for a report email.
  public func subjectFor(reportType : ReportingTypes.ReportType, periodStart : Types.Timestamp, periodEnd : Types.Timestamp) : Text {
    "SecOps Platform " # reportTypeLabel(reportType) # " Report: " #
      Scheduler.formatDate(periodStart) # " to " # Scheduler.formatDate(periodEnd);
  };

  /// Build the HTML body for a report email.
  public func bodyFor(
    reportType : ReportingTypes.ReportType,
    periodStart : Types.Timestamp,
    periodEnd : Types.Timestamp,
    generatedBy : Text,
    summaryLines : [Text]
  ) : Text {
    var body = "<h1>SecOps Platform " # reportTypeLabel(reportType) # " Report</h1>";
    body := body # "<p><strong>Period:</strong> " # Scheduler.formatDate(periodStart) # " to " # Scheduler.formatDate(periodEnd) # "</p>";
    body := body # "<p><strong>Generated by:</strong> " # generatedBy # "</p>";
    body := body # "<h2>Executive Summary</h2><ul>";
    for (line in summaryLines.values()) {
      body := body # "<li>" # line # "</li>";
    };
    body := body # "</ul>";
    body := body # "<p>This is an automated report from SecOps Platform.</p>";
    body;
  };

  /// Send a report to every recipient and return the per-recipient outcomes.
  /// A failed send never throws; it is recorded as a failed delivery.
  public func deliver(
    recipients : [Text],
    reportType : ReportingTypes.ReportType,
    periodStart : Types.Timestamp,
    periodEnd : Types.Timestamp,
    generatedBy : Text,
    summaryLines : [Text]
  ) : async [ReportingTypes.ReportDeliveryOutcome] {
    let subject = subjectFor(reportType, periodStart, periodEnd);
    let body = bodyFor(reportType, periodStart, periodEnd, generatedBy, summaryLines);
    let outcomes = List.empty<ReportingTypes.ReportDeliveryOutcome>();
    for (recipient in recipients.values()) {
      let result = await EmailClient.sendServiceEmail("no-reply", [recipient], subject, body);
      let nowNs = Time.now();
      switch (result) {
        case (#ok) {
          outcomes.add({ recipient; success = true; error = null; sentAt = ?nowNs });
        };
        case (#err(error)) {
          outcomes.add({ recipient; success = false; error = ?error; sentAt = null });
        };
      };
    };
    outcomes.toArray();
  };

  func reportTypeLabel(reportType : ReportingTypes.ReportType) : Text {
    switch (reportType) {
      case (#SecurityPosture) "Security Posture";
      case (#ComplianceStatus) "Compliance Status";
      case (#IncidentSummary) "Incident Summary";
      case (#ThreatIntelSummary) "Threat Intelligence Summary";
    };
  };
};
